<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="pos_config_settings_item_count">
        <field name="name">res.config.settings.pos.weight.scale.screen</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='customer_display']" position="after">
                <setting id="weight_display" string="Weight Scale Barcode" help="Create a product weight barcode from the POS scale and print it.">
                    <field name="pos_is_weight_scale_screen"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
