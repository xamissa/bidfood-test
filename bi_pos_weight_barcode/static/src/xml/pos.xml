<?xml version="1.0" encoding="UTF-8"?>
<templates id="bi_pos_weight_barcode_template" xml:space="preserve">
    <t t-name="bi_pos_weight_barcode.BiScaleScreen">
        <Dialog size="'md'">
            <t t-set-slot="header">
                <h4 class="modal-title text-break text-center w-100">
                    <t t-esc="product?.display_name || product?.name || 'Weighted Product'"/>
                </h4>
            </t>

            <div class="d-flex flex-column gap-3">
                <t t-if="!state.barcode">
                    <div class="d-flex justify-content-between fs-4">
                        <span>Gross Weight</span>
                        <strong t-esc="scale.grossWeightString"/>
                    </div>
                    <div class="d-flex justify-content-between fs-4">
                        <span>Net Weight</span>
                        <strong t-esc="scale.netWeightString"/>
                    </div>
                    <div class="d-flex justify-content-between fs-4">
                        <span>Unit Price</span>
                        <strong t-esc="scale.unitPriceString"/>
                    </div>
                    <div class="d-flex justify-content-between fs-3">
                        <span>Total</span>
                        <strong t-esc="scale.totalPriceString"/>
                    </div>
                    <button t-if="scale.isManualMeasurement"
                            class="btn btn-secondary btn-lg"
                            t-att-disabled="scale.loading"
                            t-on-click="() => scale.readWeight()">
                        Get Weight
                    </button>
                </t>
                <t t-else="">
                    <div class="text-center">
                        <WBReceipt barcode="state.barcode"
                                   productName="state.productName"
                                   weight="state.weight"
                                   price="state.price"/>
                    </div>
                </t>
            </div>

            <t t-set-slot="footer">
                <t t-if="!state.barcode">
                    <button class="btn btn-outline-secondary w-100" t-on-click="props.close">Cancel</button>
                    <button class="btn btn-primary w-100"
                            t-att-disabled="!scale.isWeightValid || state.creating"
                            t-on-click="createBarcode">
                        Generate Barcode
                    </button>
                    <button class="btn btn-success w-100"
                            t-att-disabled="!scale.isWeightValid"
                            t-on-click="confirm">
                        Add to Order
                    </button>
                </t>
                <t t-else="">
                    <button class="btn btn-primary w-100" t-on-click="printBarcode">Print Barcode</button>
                    <button class="btn btn-success w-100" t-on-click="closeAfterBarcode">Done</button>
                </t>
            </t>
        </Dialog>
    </t>

    <t t-name="bi_pos_weight_barcode.WBReceipt">
        <div class="pos-receipt" style="text-align:left;width:300px;background:white;padding:15px;">
            <div class="text-center fw-bold" t-esc="todaydate"/>
            <svg t-att-id="'wb-barcode-' + props.barcode" style="display:block;margin:10px auto;"/>
            <div class="text-center" t-esc="props.productName"/>
            <div class="d-flex justify-content-between mt-2">
                <span t-esc="props.weight"/>
                <span t-esc="props.price"/>
            </div>
        </div>
    </t>
</templates>
