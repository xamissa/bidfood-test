<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="custom_receipts_for_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="t-if">isStandardReceipt</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt')]" position="after">
            <t t-if="!isStandardReceipt">
                <t t-component="templateComponent" t-props="templateProps"/>
            </t>
        </xpath>
    </t>
</templates>
