<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_product_display_price_tag.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]" position="attributes">
            <attribute name="style">font-size:14.5px !important;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product-content')]" position="before">
            <div class="px-2 py-1 rounded-top-3" style="background-color:#714B67;color:#fff;">
                <t t-esc="env.utils.formatCurrency(props.product?.lst_price || 0)"/>
            </div>
        </xpath>
    </t>
</templates>
